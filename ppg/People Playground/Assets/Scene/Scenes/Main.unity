MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 194}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 86e4dcb4fa53a9741a454a5c904d52b6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Tools:
  - Name: Drag
    Description: Drag and rotate objects.
    Icon: {fileID: 21300000, guid: 4d07b19a3287a9c469198802c7cbaf23, type: 3}
    Type: DragTool
    ToSortBy: 
    Parent: 
  - Name: Wire
    Description: A conducting wire.
    Icon: {fileID: 21300000, guid: 2683647da7a3ccf4e892a87665cd408e, type: 3}
    Type: EnergyWireTool
    ToSortBy: 
    Parent: 
  - Name: Copper wire
    Description: Destructible conductive wire.
    Icon: {fileID: 21300000, guid: 0f539c0bb4db57542b98c1060f262a51, type: 3}
    Type: CopperWireTool
    ToSortBy: 
    Parent: Wire
  - Name: Cable
    Description: Indestructible loose cable.
    Icon: {fileID: 21300000, guid: 31c879b48681e014ebd180fa56202690, type: 3}
    Type: CableWireTool
    ToSortBy: 
    Parent: Wire
  - Name: Rope
    Description: Destructible non-conductive wire.
    Icon: {fileID: 21300000, guid: 0fd1f492e710b2949b6b429da1aa32e9, type: 3}
    Type: RopeTool
    ToSortBy: 
    Parent: Wire
  - Name: Liquid conduit
    Description: A wire that transfers liquid between containers. Usually used to
      siphon blood from humans.
    Icon: {fileID: 21300000, guid: 86018907925f20340a634d197fa19eeb, type: 3}
    Type: BloodWireTool
    ToSortBy: 
    Parent: Wire
  - Name: Chain
    Description: Wire but it looks like a chain
    Icon: {fileID: 21300000, guid: 7a172ad13ecc77148b7a44f6e7a9593e, type: 3}
    Type: ChainWireTool
    ToSortBy: 
    Parent: Wire
  - Name: Rigid cable
    Description: Indestructible rigid connection.
    Icon: {fileID: 21300000, guid: 37dfdcb31f000a74cb5669987bc94def, type: 3}
    Type: RigidWireTool
    ToSortBy: 
    Parent: 
  - Name: Heat pipe
    Description: Transfers heat
    Icon: {fileID: 21300000, guid: 30f0e5ada13b74b43b0599d6484dd2a5, type: 3}
    Type: HeatPipeTool
    ToSortBy: 
    Parent: Rigid cable
  - Name: Wooden strut
    Description: Destructible rigid strut
    Icon: {fileID: 21300000, guid: 0fa17d8513c31c242937d783eb719961, type: 3}
    Type: WoodStrutTool
    ToSortBy: 
    Parent: Rigid cable
  - Name: Propagation wire
    Description: Propagates an activation trigger from one object to another. Direction
      in which you link the cables is relevant. Signal is on the green (main) channel.
    Icon: {fileID: 21300000, guid: dd6f4f2166e9442438e5532ede20a868, type: 3}
    Type: UseWireTool
    ToSortBy: 
    Parent: 
  - Name: Destructible red propagation wire
    Description: A destructible version of the red propagation wire
    Icon: {fileID: 21300000, guid: 5e62786ca78f1af4b8b9cbbad472bae3, type: 3}
    Type: DestructibleRedUseWireTool
    ToSortBy: 
    Parent: Propagation wire
  - Name: Destructible blue propagation wire
    Description: A destructible version of the blue propagation wire
    Icon: {fileID: 21300000, guid: d8de34f4679cb694ca7e0f3974c375c4, type: 3}
    Type: DestructibleBlueUseWireTool
    ToSortBy: 
    Parent: Propagation wire
  - Name: Destructible propagation wire
    Description: A destructible version of the green propagation wire
    Icon: {fileID: 21300000, guid: 921102162af5f5c4189126d48fd89e5b, type: 3}
    Type: DestructibleUseWireTool
    ToSortBy: 
    Parent: Propagation wire
  - Name: Red propagation wire
    Description: Propagates a signal on the red channel
    Icon: {fileID: 21300000, guid: 5c41fb1ac18c32648ad3438c2c4ebec6, type: 3}
    Type: RedUseWireTool
    ToSortBy: 
    Parent: Propagation wire
  - Name: Blue propagation wire
    Description: Propagates a signal on the blue channel
    Icon: {fileID: 21300000, guid: 43ad10d6374108b4e9c7f1e26cd956a2, type: 3}
    Type: BlueUseWireTool
    ToSortBy: 
    Parent: Propagation wire
  - Name: Fixed cable
    Description: Indestructible cable that restricts positions and rotation on both
      objects
    Icon: {fileID: 21300000, guid: e95cfac9285768c4fb94942826091be6, type: 3}
    Type: FixedCableTool
    ToSortBy: 
    Parent: 
  - Name: Steel binding
    Description: Destructible steel fixed wiring
    Icon: {fileID: 21300000, guid: 3afdee8e58071f2448cef968ee262234, type: 3}
    Type: SteelBindingTool
    ToSortBy: 
    Parent: Fixed cable
  - Name: Wooden binding
    Description: Destructible wooden fixed wiring
    Icon: {fileID: 21300000, guid: 13ff7e3cab543f04f994091e21ee2f1c, type: 3}
    Type: WoodenBindingTool
    ToSortBy: SteelBinding2
    Parent: Fixed cable
  - Name: Spring
    Description: Indestructible metal spring
    Icon: {fileID: 21300000, guid: be470b3d94a6d8d4abfbe5905ebec1c0, type: 3}
    Type: SpringWireTool
    ToSortBy: 
    Parent: 
  - Name: Bandage
    Description: Stops bleeding, first of all, but it's also a pretty stretchy wire.
    Icon: {fileID: 21300000, guid: 487fff257e8cf4c44b6c83a423f97359, type: 3}
    Type: BandageWireTool
    ToSortBy: 
    Parent: Spring
  - Name: Strong spring
    Description: Indestructible, stiff metal spring
    Icon: {fileID: 21300000, guid: a07a64bbf4417f24ea97a78950957185, type: 3}
    Type: StrongSpringWireTool
    ToSortBy: 
    Parent: Spring
  - Name: Pin
    Description: Pins objects to the background or to other objects.  Allows rotation.
    Icon: {fileID: 21300000, guid: 48f8f963604d0be4784e19bbdffb0e40, type: 3}
    Type: PinTool
    ToSortBy: 
    Parent: 
  - Name: Wooden pin
    Description: Destructible pin
    Icon: {fileID: 21300000, guid: 512e2eb03fc5b2d40a184942ad3d57cb, type: 3}
    Type: WoodPinTool
    ToSortBy: 
    Parent: Pin
  - Name: Mechanical belt
    Description: A belt that wraps around two objects, transferring rotational energy.
    Icon: {fileID: 21300000, guid: 9bf6f89d5e967574a8e79937dc5177c8, type: 3}
    Type: SerpentineBeltTool
    ToSortBy: 
    Parent: 
  - Name: Phase link
    Description: A link between two objects that allows them to phase through each
      other
    Icon: {fileID: 21300000, guid: 0a591e80eebf10a46962272828da7933, type: 3}
    Type: PhaseLinkTool
    ToSortBy: 
    Parent: 
  Powers:
  - Name: Pull
    Description: Attract everything in a small radius around you.
    Icon: {fileID: 21300000, guid: 1f96da7ab5eaa384c94afc2a24fd7f0f, type: 3}
    Type: PullPowerTool
    ToSortBy: 
    Parent: 
  - Name: Push
    Description: Repulse everything in a small radius around you.
    Icon: {fileID: 21300000, guid: ca56f03d1825ad24daa1bceb24f321fb, type: 3}
    Type: PushPowerTool
    ToSortBy: 
    Parent: 
  - Name: Lift
    Description: Lift everything around you with infinite force
    Icon: {fileID: 21300000, guid: c523a7285ce3d4644a57adae8a1786bf, type: 3}
    Type: LiftPowerTool
    ToSortBy: 
    Parent: 
  - Name: Lightning
    Description: Fire lightning bolts by flicking across the screen.
    Icon: {fileID: 21300000, guid: 9f6aec0db88f24446bdc26048ce3980f, type: 3}
    Type: LightningTool
    ToSortBy: 
    Parent: 
  - Name: Pyrokinesis
    Description: Fire powers
    Icon: {fileID: 21300000, guid: 5406925850d1b5140b2d5231d79c9522, type: 3}
    Type: PyroPowerTool
    ToSortBy: 
    Parent: 
